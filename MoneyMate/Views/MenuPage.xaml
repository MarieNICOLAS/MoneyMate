<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:MoneyMate.Components.Layout"
             x:Class="MoneyMate.Views.MenuPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundLight}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- HEADER -->
        <components:HeaderAuthenticated Grid.Row="0" />

        <!-- CONTENU -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="0" Padding="20,16,20,20">

                <Label Text="Menu"
                       FontSize="26" FontAttributes="Bold"
                       TextColor="{StaticResource TextDark}"
                       Margin="0,0,0,20"/>

                <!-- ── BUDGETS ── -->
                <Label Text="BUDGETS" FontSize="11" TextColor="#AAAAAA"
                       FontAttributes="Bold" Margin="0,0,0,8"/>

                <Frame Padding="0" CornerRadius="16" BorderColor="Transparent"
                       BackgroundColor="White" HasShadow="True" Margin="0,0,0,16">
                    <VerticalStackLayout Spacing="0">

                        <Button Text="➕  Ajouter un budget"
                                Command="{Binding GoAddBudgetCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource TextDark}"
                                FontSize="15" HorizontalOptions="Start"
                                Padding="16,14"/>
                        <BoxView HeightRequest="1" BackgroundColor="#F0F0F0" Margin="16,0"/>
                        <Button Text="✏️  Modifier un budget"
                                Command="{Binding GoEditBudgetCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource TextDark}"
                                FontSize="15" HorizontalOptions="Start"
                                Padding="16,14"/>

                    </VerticalStackLayout>
                </Frame>

                <!-- ── CATÉGORIES ── -->
                <Label Text="CATÉGORIES" FontSize="11" TextColor="#AAAAAA"
                       FontAttributes="Bold" Margin="0,0,0,8"/>

                <Frame Padding="0" CornerRadius="16" BorderColor="Transparent"
                       BackgroundColor="White" HasShadow="True" Margin="0,0,0,16">
                    <VerticalStackLayout Spacing="0">

                        <Button Text="➕  Ajouter une catégorie"
                                Command="{Binding GoAddCategoryCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource TextDark}"
                                FontSize="15" HorizontalOptions="Start"
                                Padding="16,14"/>
                        <BoxView HeightRequest="1" BackgroundColor="#F0F0F0" Margin="16,0"/>
                        <Button Text="✏️  Modifier une catégorie"
                                Command="{Binding GoEditCategoryCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource TextDark}"
                                FontSize="15" HorizontalOptions="Start"
                                Padding="16,14"/>

                    </VerticalStackLayout>
                </Frame>

                <!-- ── DÉPENSES ── -->
                <Label Text="DÉPENSES" FontSize="11" TextColor="#AAAAAA"
                       FontAttributes="Bold" Margin="0,0,0,8"/>

                <Frame Padding="0" CornerRadius="16" BorderColor="Transparent"
                       BackgroundColor="White" HasShadow="True" Margin="0,0,0,16">
                    <VerticalStackLayout Spacing="0">

                        <Button Text="➕  Ajouter une dépense"
                                Command="{Binding GoAddExpenseCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource TextDark}"
                                FontSize="15" HorizontalOptions="Start"
                                Padding="16,14"/>
                        <BoxView HeightRequest="1" BackgroundColor="#F0F0F0" Margin="16,0"/>
                        <Button Text="📋  Historique des dépenses"
                                Command="{Binding GoHistoryCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource TextDark}"
                                FontSize="15" HorizontalOptions="Start"
                                Padding="16,14"/>

                    </VerticalStackLayout>
                </Frame>

                <!-- ── NOTIFICATIONS ── -->
                <Label Text="NOTIFICATIONS" FontSize="11" TextColor="#AAAAAA"
                       FontAttributes="Bold" Margin="0,0,0,8"/>

                <Frame Padding="0" CornerRadius="16" BorderColor="Transparent"
                       BackgroundColor="White" HasShadow="True" Margin="0,0,0,16">
                    <VerticalStackLayout Spacing="0">

                        <Button Text="🔔  Notifications"
                                Command="{Binding GoNotificationsCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource TextDark}"
                                FontSize="15" HorizontalOptions="Start"
                                Padding="16,14"/>

                    </VerticalStackLayout>
                </Frame>

                <!-- ── STATISTIQUES ── -->
                <Label Text="STATISTIQUES" FontSize="11" TextColor="#AAAAAA"
                       FontAttributes="Bold" Margin="0,0,0,8"/>

                <Frame Padding="0" CornerRadius="16" BorderColor="Transparent"
                       BackgroundColor="White" HasShadow="True" Margin="0,0,0,16">
                    <VerticalStackLayout Spacing="0">

                        <Button Text="📊  Statistiques"
                                Command="{Binding GoStatisticsCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource TextDark}"
                                FontSize="15" HorizontalOptions="Start"
                                Padding="16,14"/>

                    </VerticalStackLayout>
                </Frame>

                <!-- ── DÉCONNEXION ── -->
                <Frame Padding="0" CornerRadius="16" BorderColor="Transparent"
                       BackgroundColor="White" HasShadow="True" Margin="0,8,0,0">
                    <Button Text="🚪  Se déconnecter"
                            Command="{Binding LogoutCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Error}"
                            FontSize="15" HorizontalOptions="Start"
                            Padding="16,14"/>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- NAVBAR -->
        <components:Navbar Grid.Row="2" />

    </Grid>
</ContentPage>
