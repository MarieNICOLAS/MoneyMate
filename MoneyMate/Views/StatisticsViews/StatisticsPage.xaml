<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:MoneyMate.Components.Layout"
             xmlns:vm="clr-namespace:MoneyMate.ViewModels"
             x:Class="MoneyMate.Views.StatisticsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundLight}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ══════════════════════════════════════
             HEADER
             ══════════════════════════════════════ -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource PrimaryLight}"
                StrokeThickness="0"
                Padding="0">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,4" Radius="6" Opacity="0.2"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                  Padding="16,10"
                  VerticalOptions="Center">

                <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                    <Image Source="money_mate_icon.png" WidthRequest="26" HeightRequest="26" VerticalOptions="Center"/>
                    <Label Text="MoneyMate" FontAttributes="Bold" FontSize="18"
                           TextColor="{StaticResource TextDark}" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- Notification avec badge -->
                <Grid Grid.Column="2" Margin="0,0,10,0" VerticalOptions="Center">
                    <ImageButton Source="alarm_on_icon.png" BackgroundColor="Transparent"
                                 WidthRequest="26" HeightRequest="26"/>
                    <Border BackgroundColor="Red" StrokeThickness="0"
                            StrokeShape="RoundRectangle 8"
                            WidthRequest="14" HeightRequest="14"
                            HorizontalOptions="End" VerticalOptions="Start" Margin="0,0,-2,0">
                        <Label Text="2" FontSize="8" TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                </Grid>

                <!-- Settings -->
                <ImageButton Grid.Column="3" Source="settings_icon.png"
                             BackgroundColor="Transparent"
                             WidthRequest="26" HeightRequest="26"
                             Margin="0,0,10,0" VerticalOptions="Center"/>

                <!-- Profil -->
                <Border Grid.Column="4" StrokeThickness="1"
                        Stroke="#AAAAAA"
                        StrokeShape="RoundRectangle 20"
                        WidthRequest="32" HeightRequest="32" VerticalOptions="Center">
                    <Image Source="profile_icon.png" WidthRequest="28" HeightRequest="28"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════
             CONTENU SCROLLABLE
             ══════════════════════════════════════ -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="0" Padding="0,0,0,12">

                <!-- Titre -->
                <Label Text="Statistics"
                       FontSize="28" FontAttributes="Bold"
                       TextColor="{StaticResource TextDark}"
                       Margin="20,14,20,4"/>

                <!-- ══════════════════════════════════════
                     CARTE 1 — GRAPHIQUE EN COURBES
                     ══════════════════════════════════════ -->
                <Frame Margin="16,4,16,12" Padding="16,14" CornerRadius="16"
                       BackgroundColor="White" BorderColor="Transparent" HasShadow="True">
                    <VerticalStackLayout Spacing="12">

                        <!-- Titre + boutons Year / Month -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Top"
                                   FontSize="15" FontAttributes="Bold"
                                   TextColor="{StaticResource TextDark}"
                                   VerticalOptions="Center"/>

                            <Border Grid.Column="1"
                                    BackgroundColor="#F0F0F0"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="3">
                                <HorizontalStackLayout Spacing="2">

                                    <Button Text="Year"
                                            Command="{Binding SelectPeriodCommand}"
                                            CommandParameter="Year"
                                            FontSize="12" CornerRadius="12"
                                            Padding="14,4" HeightRequest="28">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button"
                                                         Binding="{Binding SelectedPeriod}"
                                                         Value="Year">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
                                                <Setter Property="TextColor" Value="White"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Button"
                                                         Binding="{Binding SelectedPeriod}"
                                                         Value="Month">
                                                <Setter Property="BackgroundColor" Value="Transparent"/>
                                                <Setter Property="TextColor" Value="#AAAAAA"/>
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>

                                    <Button Text="Month"
                                            Command="{Binding SelectPeriodCommand}"
                                            CommandParameter="Month"
                                            FontSize="12" CornerRadius="12"
                                            Padding="14,4" HeightRequest="28">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button"
                                                         Binding="{Binding SelectedPeriod}"
                                                         Value="Month">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
                                                <Setter Property="TextColor" Value="White"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Button"
                                                         Binding="{Binding SelectedPeriod}"
                                                         Value="Year">
                                                <Setter Property="BackgroundColor" Value="Transparent"/>
                                                <Setter Property="TextColor" Value="#AAAAAA"/>
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>

                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <!-- Total -->
                        <Label Text="{Binding LineTotal}"
                               FontSize="12" TextColor="#AAAAAA"
                               HorizontalOptions="End"/>

                        <!-- Graphique courbes -->
                        <Grid ColumnDefinitions="36,*" HeightRequest="180">
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Fill" Spacing="14">
                                <Label Text="1200" FontSize="8" TextColor="#AAAAAA" HorizontalOptions="End" Margin="0,0,4,0"/>
                                <Label Text="1000" FontSize="8" TextColor="#AAAAAA" HorizontalOptions="End" Margin="0,0,4,0"/>
                                <Label Text="800"  FontSize="8" TextColor="#AAAAAA" HorizontalOptions="End" Margin="0,0,4,0"/>
                                <Label Text="600"  FontSize="8" TextColor="#AAAAAA" HorizontalOptions="End" Margin="0,0,4,0"/>
                                <Label Text="400"  FontSize="8" TextColor="#AAAAAA" HorizontalOptions="End" Margin="0,0,4,0"/>
                                <Label Text="200"  FontSize="8" TextColor="#AAAAAA" HorizontalOptions="End" Margin="0,0,4,0"/>
                                <Label Text="0"    FontSize="8" TextColor="#AAAAAA" HorizontalOptions="End" Margin="0,0,4,0"/>
                            </VerticalStackLayout>

                            <Grid Grid.Column="1">
                                <BoxView HeightRequest="1" BackgroundColor="#F0F0F0" VerticalOptions="Start" Margin="0,0"/>
                                <BoxView HeightRequest="1" BackgroundColor="#F0F0F0" VerticalOptions="Start" Margin="0,26"/>
                                <BoxView HeightRequest="1" BackgroundColor="#F0F0F0" VerticalOptions="Start" Margin="0,52"/>
                                <BoxView HeightRequest="1" BackgroundColor="#F0F0F0" VerticalOptions="Start" Margin="0,78"/>
                                <BoxView HeightRequest="1" BackgroundColor="#F0F0F0" VerticalOptions="Start" Margin="0,104"/>
                                <BoxView HeightRequest="1" BackgroundColor="#F0F0F0" VerticalOptions="Start" Margin="0,130"/>
                                <BoxView HeightRequest="1" BackgroundColor="#CCCCCC" VerticalOptions="End" Margin="0,0"/>

                                <CollectionView ItemsSource="{Binding LinePoints}"
                                                ItemsLayout="HorizontalList"
                                                VerticalOptions="Fill"
                                                Margin="0,0,0,16">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ChartPoint">
                                            <VerticalStackLayout WidthRequest="24" Spacing="2"
                                                                 VerticalOptions="EndAndExpand">
                                                <BoxView BackgroundColor="{StaticResource Primary}"
                                                         WidthRequest="4" HorizontalOptions="Center"
                                                         CornerRadius="2"
                                                         HeightRequest="{Binding NormalizedHeight}"
                                                         VerticalOptions="End"/>
                                                <Ellipse Fill="{StaticResource Primary}"
                                                         WidthRequest="6" HeightRequest="6"
                                                         HorizontalOptions="Center"/>
                                                <Label Text="{Binding Label}" FontSize="8"
                                                       TextColor="#AAAAAA" HorizontalOptions="Center"/>
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>
                        </Grid>

                    </VerticalStackLayout>
                </Frame>

                <!-- ══════════════════════════════════════
                     CARTE 2 — GRAPHIQUE EN BARRES
                     ══════════════════════════════════════ -->
                <Frame Margin="16,0,16,12" Padding="16,14" CornerRadius="16"
                       BackgroundColor="White" BorderColor="Transparent" HasShadow="True">
                    <VerticalStackLayout Spacing="12">

                        <!-- Titre + Picker année -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="Revenus et dépenses"
                                   FontSize="15" FontAttributes="Bold"
                                   TextColor="{StaticResource TextDark}"
                                   VerticalOptions="Center"/>

                            <Border Grid.Column="1"
                                    BackgroundColor="#F0F0F0"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="4,2">
                                <Picker ItemsSource="{Binding YearOptions}"
                                        SelectedItem="{Binding SelectedYear, Mode=TwoWay}"
                                        FontSize="13"
                                        TextColor="{StaticResource TextDark}"
                                        BackgroundColor="Transparent"
                                        MinimumWidthRequest="80"
                                        HorizontalOptions="Center"/>
                            </Border>
                        </Grid>

                        <!-- Légende -->
                        <HorizontalStackLayout Spacing="20">
                            <HorizontalStackLayout Spacing="6">
                                <BoxView WidthRequest="12" HeightRequest="12"
                                         BackgroundColor="{StaticResource Primary}"
                                         CornerRadius="2" VerticalOptions="Center"/>
                                <Label Text="Budget" FontSize="12"
                                       TextColor="#AAAAAA" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6">
                                <BoxView WidthRequest="12" HeightRequest="12"
                                         BackgroundColor="#D4D8DE"
                                         CornerRadius="2" VerticalOptions="Center"/>
                                <Label Text="Dépenses" FontSize="12"
                                       TextColor="#AAAAAA" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>

                        <!-- Graphique barres -->
                        <Grid ColumnDefinitions="36,*" HeightRequest="220">
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Fill" Spacing="0">
                                <Label Text="{Binding BarMaxValue, StringFormat='{0:0}€'}"
                                       FontSize="8" TextColor="#AAAAAA"
                                       HorizontalOptions="End" Margin="0,0,4,0"/>
                                <Label Text="{Binding BarMidValue, StringFormat='{0:0}€'}"
                                       FontSize="8" TextColor="#AAAAAA"
                                       HorizontalOptions="End" Margin="0,0,4,0"
                                       VerticalOptions="CenterAndExpand"/>
                                <Label Text="0€" FontSize="8" TextColor="#AAAAAA"
                                       HorizontalOptions="End" Margin="0,0,4,0"
                                       VerticalOptions="End"/>
                            </VerticalStackLayout>

                            <ScrollView Grid.Column="1" Orientation="Horizontal">
                                <CollectionView ItemsSource="{Binding BarMonths}"
                                                ItemsLayout="HorizontalList"
                                                VerticalOptions="Fill">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BarMonth">
                                            <VerticalStackLayout WidthRequest="28" Spacing="1"
                                                                 VerticalOptions="EndAndExpand"
                                                                 Margin="3,0">
                                                <BoxView BackgroundColor="{StaticResource Primary}"
                                                         WidthRequest="10" HorizontalOptions="Start"
                                                         CornerRadius="2,2,0,0"
                                                         HeightRequest="{Binding BudgetBarHeight}"
                                                         VerticalOptions="End"/>
                                                <BoxView BackgroundColor="{Binding SpentBarColor}"
                                                         WidthRequest="10" HorizontalOptions="End"
                                                         CornerRadius="2,2,0,0"
                                                         HeightRequest="{Binding SpentBarHeight}"
                                                         VerticalOptions="End"/>
                                                <Label Text="{Binding Month}" FontSize="8"
                                                       TextColor="#AAAAAA"
                                                       HorizontalOptions="Center"
                                                       Margin="0,3,0,0"/>
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </ScrollView>
                        </Grid>

                        <Label Text="Aucune donnée disponible pour cette année."
                               FontSize="13" TextColor="#AAAAAA"
                               HorizontalOptions="Center"
                               IsVisible="{Binding HasNoData}"/>

                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ══════════════════════════════════════
             NAVBAR
             ══════════════════════════════════════ -->
        <components:Navbar Grid.Row="2" />

    </Grid>
</ContentPage>
